<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0.dp"
        app:layout_constraintBottom_toTopOf="@id/llBottomAction"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <ImageView
                    android:id="@+id/ivRestaurantHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <!-- Overlay gradient for top buttons legibility -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_gradient_top_shadow" />

                <ImageView
                    android:id="@+id/btnBackRestDetails"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="20.dp"
                    android:layout_marginTop="50.dp"
                    android:background="@drawable/bg_glass_circle"
                    android:elevation="4dp"
                    android:padding="10.dp"
                    android:src="@drawable/icon_back"
                    app:tint="@color/black" />

                <ImageView
                    android:id="@+id/btnFavoriteRest"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="50.dp"
                    android:layout_marginEnd="20.dp"
                    android:background="@drawable/bg_glass_circle"
                    android:elevation="4dp"
                    android:padding="12.dp"
                    android:src="@drawable/icon_favorite"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/tvPromoBadgeDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="24.dp"
                    android:layout_marginBottom="55.dp"
                    android:background="@drawable/bg_michelin_badge"
                    android:elevation="6dp"
                    android:paddingHorizontal="12.dp"
                    android:paddingVertical="4.dp"
                    android:text="Michelin Guide"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </RelativeLayout>

            <!-- Main Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                android:background="@drawable/bg_top_rounded"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="24.dp"
                android:paddingTop="32.dp"
                android:paddingBottom="40.dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#F1F3F4"
                        app:cardBackgroundColor="@color/white"
                        android:layout_marginEnd="16.dp">

                        <ImageView
                            android:id="@+id/ivRestLogoDetails"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvRestNameDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="Lumière Bistro" />

                </LinearLayout>

                <!-- Category Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgCuisines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="0dp">
                    <!-- Chips added programmatically -->
                </com.google.android.material.chip.ChipGroup>

                <!-- Quick Info Line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/btn_star_big_on"
                        app:tint="#D44A01" />

                    <TextView
                        android:id="@+id/tvRestRatingDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4.dp"
                        android:textColor="#D44A01"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="4.8" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginHorizontal="12.dp"
                            android:background="@drawable/bg_dot"
                            android:alpha="0.3"
                            app:tint="@color/gray_text" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="@color/gray_text" />

                        <TextView
                            android:id="@+id/tvRestTimeDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4.dp"
                            android:textColor="@color/gray_text"
                            android:textSize="15sp"
                            tools:text="20-30 min" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llDistanceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginHorizontal="12.dp"
                            android:background="@drawable/bg_dot"
                            android:alpha="0.3"
                            app:tint="@color/gray_text" />

                        <ImageView
                            android:id="@+id/ivDistanceIcon"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/icon_walk"/>
                        <TextView
                            android:id="@+id/tvRestDistanceDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4.dp"
                            android:textColor="@color/gray_text"
                            android:textSize="15sp"
                            tools:text="0.8 km" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Address Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvAddressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24.dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F1F3F4">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16.dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvMapIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EEEEEE">
                            <ImageView
                                android:id="@+id/ivMapIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/icon_location"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/cvMapIcon"
                            android:layout_toStartOf="@id/ivArrow"
                            android:layout_marginStart="12.dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRestAddressDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                tools:text="123 Gourmet Ave, Paris, FR" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.dp"
                                android:text="View on map"
                                android:textColor="#1976D2"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivArrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/gray_text" />

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- About Section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32.dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/icon_about"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="About"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvRestDescriptionDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/gray_text"
                    android:textSize="15sp"
                    tools:text="Experience a fusion of traditional French techniques with modern flair..." />

                <!-- AR Explore Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvARExplore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32.dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ar_explore_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24.dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardBackgroundColor="#673AB7"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="4dp">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/icon_3d"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.dp"
                            android:text="Explore Menu in AR"
                            android:textColor="#311B92"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.dp"
                            android:gravity="center"
                            android:text="See our dishes in 3D right on your table before you order."
                            android:textColor="#5E35B1"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="24.dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewMenu"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_orange"
            android:text="View Menu"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>