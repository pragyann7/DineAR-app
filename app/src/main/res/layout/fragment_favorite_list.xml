<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="24.dp"
        android:paddingTop="8.dp"
        tools:listitem="@layout/item_restaurant" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerFav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24.dp"
        android:paddingTop="8.dp"
        android:visibility="gone"
        app:shimmer_auto_start="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include layout="@layout/skeleton_item_restaurant" />
            <include layout="@layout/skeleton_item_restaurant" />
            <include layout="@layout/skeleton_item_restaurant" />
            <include layout="@layout/skeleton_item_restaurant" />
        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <LinearLayout
        android:id="@+id/llFavNoResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32.dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:alpha="0.3"
            android:src="@drawable/icon_favorite"
            app:tint="@color/gray_text" />

        <TextView
            android:id="@+id/tvFavNoResultsMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.dp"
            android:text="No favorites yet"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.dp"
            android:gravity="center"
            android:text="Items you favorite will appear here."
            android:textAlignment="center"
            android:textColor="@color/gray_text"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>