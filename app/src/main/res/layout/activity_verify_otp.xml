<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify Email"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVerifyOtpInstructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="An OTP has been sent to your email. Please enter it below to verify your account."
        android:textAlignment="center"
        android:textColor="@color/gray_text" />

    <EditText
        android:id="@+id/etVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:hint="Enter 6-digit OTP"
        android:inputType="number"
        android:maxLength="6"
        android:textSize="18sp"
        android:autofillHints="smsOTPCode" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32.dp"
        android:background="@drawable/bg_button_orange"
        android:text="Verify"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnResendOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="8dp"
        android:text="Didn't receive code? Resend"
        android:textColor="@color/orange_primary"
        android:textStyle="bold" />

</LinearLayout>
