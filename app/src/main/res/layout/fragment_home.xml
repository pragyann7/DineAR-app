<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Search and Filter Bar -->
    <LinearLayout
        android:id="@+id/llSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24.dp"
        android:layout_marginTop="4.dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewHome"
            android:layout_width="0.dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:theme="@style/SearchViewTheme"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="Search food, restaurants..." />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnFilter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12.dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="#FFA672"
            app:cardCornerRadius="12.dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/icon_filter" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Search Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llSearchContainer"
        app:tabIndicatorColor="@color/orange_primary"
        app:tabSelectedTextColor="@color/orange_primary"
        app:tabTextColor="@color/gray_text"
        app:tabRippleColor="@null">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurants" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foods" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0.dp"
        android:layout_marginTop="16.dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutSearch">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Promo Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvPromoBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginHorizontal="24.dp"
                app:cardCornerRadius="20.dp"
                app:cardElevation="0dp"
                android:backgroundTint="#85FF5B00">

                <ImageView
                    android:id="@+id/ivPromoBannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/burger" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="24.dp">

                    <TextView
                        android:id="@+id/tvPromoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/orange_primary"
                        android:paddingHorizontal="8.dp"
                        android:paddingVertical="4.dp"
                        android:text="LIMITED OFFER"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPromoBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.dp"
                        android:text="30% Off Fine Dining\nTonight"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Category Header -->
            <RelativeLayout
                android:id="@+id/rlCategoriesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore Categories"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Category Filter -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24.dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter" />

            <!-- Explore Restaurants Header -->
            <RelativeLayout
                android:id="@+id/rlExploreHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/explore_restaurants"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="See All"
                    android:textColor="@color/orange_primary"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Explore Restaurants List -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.dp"
                    android:paddingHorizontal="24.dp"
                    tools:listitem="@layout/item_restaurant" />

                <!-- No Results Placeholder (Inline) -->
                <LinearLayout
                    android:id="@+id/llNoResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="40.dp">

                    <ImageView
                        android:id="@+id/ivNoResults"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/icon_foodcart"
                        app:tint="@color/gray_text"
                        android:alpha="0.4" />

                    <TextView
                        android:id="@+id/tvNoResultsMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.dp"
                        android:text="No treats found here!"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNoResultsDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.dp"
                        android:text="Try exploring other delicious categories!"
                        android:textColor="@color/gray_text"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:gravity="center" />

                </LinearLayout>

            </FrameLayout>

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp"
                android:background="@color/divider" />

            <RelativeLayout
                android:id="@+id/rlFeaturedFoodsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trending Dishes"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="View All"
                    android:textColor="@color/orange_primary"
                    android:textStyle="bold" />

            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeaturedFoods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24.dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_featured_food" />

            <!-- Section Divider -->
            <!-- Footer Spacer for FAB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80.dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/layoutShimmer"
        layout="@layout/layout_shimmer_home"
        android:layout_width="match_parent"
        android:layout_height="0.dp"
        android:layout_marginTop="16.dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutSearch" />

</androidx.constraintlayout.widget.ConstraintLayout>