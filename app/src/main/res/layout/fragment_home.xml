<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Search and Filter Bar -->
    <LinearLayout
        android:id="@+id/llSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24.dp"
        android:layout_marginTop="4.dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewHome"
            android:layout_width="0.dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:theme="@style/SearchViewTheme"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="Search food, restaurants..." />

        <androidx.cardview.widget.CardView
            android:id="@+id/btnFilter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12.dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/icon_filter" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Search Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llSearchContainer"
        app:tabIndicatorColor="@color/orange_primary"
        app:tabSelectedTextColor="@color/orange_primary"
        app:tabTextColor="@color/gray_text"
        app:tabRippleColor="@null">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurants" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foods" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0.dp"
        android:layout_marginTop="8.dp"
        android:visibility="gone"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutSearch">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white">

            <!-- What's on your mind? (Quick Picks) -->
            <LinearLayout
                android:id="@+id/llQuickPicksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:text="What's on your mind?"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQuickPicks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_quick_pick" />
            </LinearLayout>

            <!-- Promo Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvPromoBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp"
                app:cardCornerRadius="20.dp"
                app:cardElevation="0dp"
                android:backgroundTint="#85FF5B00">

                <ImageView
                    android:id="@+id/ivPromoBannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/burger" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="24.dp">

                    <TextView
                        android:id="@+id/tvPromoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/orange_primary"
                        android:paddingHorizontal="8.dp"
                        android:paddingVertical="4.dp"
                        android:text="LIMITED OFFER"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPromoBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.dp"
                        android:text="30% Off Fine Dining\nTonight"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Explore Categories Header -->
            <RelativeLayout
                android:id="@+id/rlCategoriesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore Categories"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Category Filter -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24.dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filter" />



            <!-- All Restaurants Container -->
            <LinearLayout
                android:id="@+id/llAllRestaurantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- All Restaurants Header -->
                <RelativeLayout
                    android:id="@+id/rlExploreHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:layout_marginTop="32.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Restaurants"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeeAllAllRestaurants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="See All"
                        android:textColor="@color/orange_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                </RelativeLayout>

                <!-- All Restaurants List -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16.dp"
                        android:paddingHorizontal="24.dp"
                        tools:listitem="@layout/item_restaurant" />

                    <!-- No Results Placeholder (Inline) -->
                    <LinearLayout
                        android:id="@+id/llNoResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:padding="40.dp">

                        <ImageView
                            android:id="@+id/ivNoResults"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/icon_foodcart"
                            app:tint="@color/gray_text"
                            android:alpha="0.4" />

                        <TextView
                            android:id="@+id/tvNoResultsMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16.dp"
                            android:text="No treats found here!"
                            android:textColor="@color/black"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNoResultsDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.dp"
                            android:text="Try exploring other delicious categories!"
                            android:textColor="@color/gray_text"
                            android:textSize="13sp"
                            android:textAlignment="center"
                            android:gravity="center" />

                    </LinearLayout>

                </FrameLayout>
            </LinearLayout>

            <!-- Trending Section Container (Keeping it as well) -->
            <LinearLayout
                android:id="@+id/llTrendingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingVertical="32.dp">

                <RelativeLayout
                    android:id="@+id/rlFeaturedFoodsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trending Dishes"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewAllFeatured"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="View All"
                        android:textColor="@color/orange_primary"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeaturedFoods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_featured_food" />

            </LinearLayout>

            <!-- Featured Restaurants Container -->
            <LinearLayout
                android:id="@+id/llFeaturedRestaurantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Featured Restaurants Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:layout_marginTop="32.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Featured Restaurants"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Featured Restaurants List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeaturedRestaurants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_restaurant_compact" />
            </LinearLayout>

            <!-- Hot Picks Container -->
            <LinearLayout
                android:id="@+id/llHotPicksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hot Picks Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:layout_marginTop="32.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hot picks from exclusive eaters"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Hot Picks List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHotPicks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_food_card_horizontal" />
            </LinearLayout>

            <!-- Price Drops Container -->
            <LinearLayout
                android:id="@+id/llPriceDropsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Price Drops Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:layout_marginTop="32.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price Drops"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewAllPriceDrops"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="See All"
                        android:textColor="@color/orange_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Price Drops List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPriceDrops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_food_card_horizontal" />
            </LinearLayout>

            <!-- Top Picks Container -->
            <LinearLayout
                android:id="@+id/llTopPicksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Top Picks Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:layout_marginTop="32.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Picks"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Top Picks List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTopPicks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_restaurant_compact" />
            </LinearLayout>



            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24.dp"
                android:layout_marginTop="32.dp"
                android:background="@color/divider" />



            <!-- Community Reviews Container -->
            <LinearLayout
                android:id="@+id/llCommunityReviewsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Community Reviews Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24.dp"
                    android:layout_marginTop="32.dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reviews"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Community Reviews List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCommunityReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24.dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_review_home" />
            </LinearLayout>

            <!-- Footer Spacer for FAB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80.dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/layoutShimmer"
        layout="@layout/layout_shimmer_home"
        android:layout_width="match_parent"
        android:layout_height="0.dp"
        android:layout_marginTop="16.dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutSearch" />

</androidx.constraintlayout.widget.ConstraintLayout>