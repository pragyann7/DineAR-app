<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollViewFood"
        android:layout_width="match_parent"
        android:layout_height="0.dp"
        app:layout_constraintBottom_toTopOf="@id/llBottomActions"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <ImageView
                    android:id="@+id/ivFoodLarge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/statusBarSpacer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnBackCard"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="20dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp">

                            <ImageView
                                android:id="@+id/btnBackDetails"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/icon_back"
                                app:tint="@color/black" />

                        </androidx.cardview.widget.CardView>

                        <ImageView
                            android:id="@+id/btnFavoriteFoodDetails"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="20.dp"
                            android:background="@drawable/bg_glass_circle"
                            android:elevation="4dp"
                            android:padding="12.dp"
                            android:src="@drawable/icon_favorite"
                            app:tint="@color/black" />

                    </RelativeLayout>
                </LinearLayout>

                <!-- Top Shadow for better button visibility -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_gradient_top_shadow" />

            </RelativeLayout>

            <!-- Main Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-30dp"
                android:background="@drawable/bg_top_rounded"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="24.dp"
                android:paddingTop="32.dp"
                android:paddingBottom="40.dp">

                <TextView
                    android:id="@+id/tvFoodCategoryDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textColor="@color/gray_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Starters" />

                <LinearLayout
                    android:id="@+id/llRestaurantLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/icon_home"
                        app:tint="@color/orange_primary" />

                    <TextView
                        android:id="@+id/tvRestaurantNameDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/orange_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="The Italian Kitchen" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/orange_primary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvFoodNameDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/black"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Coquilles St. Jacques" />

                <!-- Category Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgCuisines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="0dp">
                    <!-- Chips added programmatically -->
                </com.google.android.material.chip.ChipGroup>

                <!-- Price and Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFoodPriceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#D44A01"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="NPR 950" />

                    <TextView
                        android:id="@+id/tvFoodOldPriceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12.dp"
                        android:textColor="@color/gray_text"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:text="NPR 1,250" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Rating Badge -->
                    <LinearLayout
                        android:id="@+id/llFoodRatingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_light"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8.dp"
                        android:paddingVertical="4.dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#D44A01" />

                        <TextView
                            android:id="@+id/tvFoodRatingDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4.dp"
                            android:text="N/A"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Signature Badge -->
                    <LinearLayout
                        android:id="@+id/llSignatureTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8.dp"
                        android:background="@drawable/bg_badge_light"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8.dp"
                        android:paddingVertical="4.dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#D44A01" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4.dp"
                            android:text="Signature"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescriptionDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24.dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/gray_text"
                    android:textSize="15sp"
                    tools:text="Hand-dived Atlantic scallops seared to perfection..." />

                <!-- AR Explore Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvARExploreFood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32.dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ar_explore_card_new"
                        android:padding="16.dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvARIcon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:cardUseCompatPadding="true"
                            app:cardBackgroundColor="@color/white"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E0E0E0">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/icon_3d" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/cvARIcon"
                            android:layout_toStartOf="@id/btnARArrow"
                            android:layout_marginStart="16.dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="See it in AR"
                                android:textColor="@color/black"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2.dp"
                                android:text="Place dish on your table"
                                android:textColor="@color/gray_text"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnARArrow"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/white">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="#F45905" />
                        </com.google.android.material.card.MaterialCardView>

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Reviews & Ratings Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32.dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reviews &amp; Ratings"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWriteReviewDetails"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:text="Write Review"
                            android:textAllCaps="false"
                            android:textColor="@color/orange_primary"
                            android:textSize="12sp"
                            android:paddingHorizontal="12dp"
                            app:strokeColor="@color/orange_primary"
                            app:strokeWidth="1dp"
                            app:cornerRadius="20dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvReviewsCountDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="(0 dish reviews)"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llRatingSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvAvgRatingDetailsLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="N/A"
                                android:textColor="@color/black"
                                android:textSize="36sp"
                                android:textStyle="bold" />
                            <RatingBar
                                android:id="@+id/rbAvgRatingDetails"
                                style="@style/Widget.AppCompat.RatingBar.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:numStars="5"
                                android:progressTint="@color/orange_primary"
                                android:rating="0.0" />
                            <TextView
                                android:id="@+id/tvAvgRatingSubtext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="New Dish"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <include layout="@layout/layout_rating_bar_row" android:id="@+id/row5_details" />
                            <include layout="@layout/layout_rating_bar_row" android:id="@+id/row4_details" />
                            <include layout="@layout/layout_rating_bar_row" android:id="@+id/row3_details" />
                            <include layout="@layout/layout_rating_bar_row" android:id="@+id/row2_details" />
                            <include layout="@layout/layout_rating_bar_row" android:id="@+id/row1_details" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- AR Accuracy Card -->
                    <LinearLayout
                        android:id="@+id/llARAccuracyDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_ar_accuracy_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/white">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/icon_3d"
                                app:tint="@color/orange_text" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvARAccuracyDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="96% AR Match Accuracy"
                                android:textColor="@color/orange_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Users agree that the real dish matches the AR preview."
                                android:textColor="@color/gray_text"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Top Reviews -->
                    <TextView
                        android:id="@+id/tvTopReviewsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Top Reviews"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/llTopReviewsContainerDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Empty State for Reviews -->
                    <LinearLayout
                        android:id="@+id/llEmptyReviewsDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="visible">
                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:alpha="0.2"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="@color/gray_text" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="No reviews yet"
                            android:textColor="@color/gray_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Be the first to share your experience!"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSeeAllReviewsDetails"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_see_all_button"
                        android:text="See All 42 Reviews →"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/llBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20.dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Quantity Selector -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@drawable/bg_badge_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8.dp">

            <ImageView
                android:id="@+id/btnMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="12dp"
                android:src="@drawable/ic_minus"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/black" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16.dp"
            android:background="@drawable/bg_button_orange"
            android:text="Add to Cart"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>