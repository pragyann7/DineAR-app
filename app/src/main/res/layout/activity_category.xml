<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnBackCategory"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/btnBackCategory"
            android:text="Categories"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Explore Restaurants"
                android:textColor="@color/gray_text"
                android:textSize="14sp" />

            <!-- Food Type Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Food Type"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/catVeg"
                    style="@style/CategoryTagStyle"
                    android:text="🥗 Vegetarian" />

                <TextView
                    android:id="@+id/catNonVeg"
                    style="@style/CategoryTagStyle"
                    android:layout_marginStart="12dp"
                    android:text="🍗 Non-Veg" />

            </LinearLayout>

            <!-- Restaurant Type Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Restaurant Type"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <TextView
                    android:id="@+id/catFastFood"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="🍔 Fast Food" />

                <TextView
                    android:id="@+id/catCafe"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="☕ Café" />

                <TextView
                    android:id="@+id/catFineDining"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🍽 Fine Dining" />

                <TextView
                    android:id="@+id/catBakery"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:text="🥐 Bakery" />

            </GridLayout>

            <!-- Cuisine Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Cuisine"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.dp"
                android:columnCount="2"
                android:useDefaultMargins="false"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/catNepali"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="🇳🇵 Nepali" />

                <TextView
                    android:id="@+id/catIndian"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="🇮🇳 Indian" />

                <TextView
                    android:id="@+id/catChinese"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🥡 Chinese" />

                <TextView
                    android:id="@+id/catPizza"
                    style="@style/CategoryTagStyle"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:text="🍕 Pizza" />

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>